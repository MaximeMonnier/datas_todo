#!/usr/bin/env bash
# runbackend : lance le serveur Django (venv + deps + migrations + runserver)
set -e

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/backend"

# 1. Creer le venv s'il n'existe pas
if [ ! -d ".venv" ]; then
    echo "==> Environnement virtuel absent, creation..."
    python3 -m venv .venv
fi

# 2. Activer le venv
echo "==> Activation du venv"
source .venv/bin/activate

# 3. Installer les dependances
echo "==> Installation des dependances"
pip install -q -r requirements.txt

# 4. Appliquer les migrations
echo "==> Migrations"
python manage.py migrate --no-input

# 5. Lancer le serveur
echo "==> Serveur sur http://127.0.0.1:8000"
python manage.py runserver
